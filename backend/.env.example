# ─── App ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ─── MongoDB ───────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/mobly

# ─── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ─── Redis (Bull queues) ───────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=5678
REDIS_PASSWORD=

# ─── n8n ───────────────────────────────────────────────────────────
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your_n8n_api_key
N8N_SCRAPE_WEBHOOK=http://localhost:5678/webhook/scrape-jobs
N8N_CV_WEBHOOK=http://localhost:5678/webhook/generate-cv
N8N_APPLY_WEBHOOK=http://localhost:5678/webhook/auto-apply
N8N_NOTIFY_WEBHOOK=http://localhost:5678/webhook/notify

# ─── Email (Nodemailer) ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Mobly <noreply@mobly.app>"

# ─── WhatsApp Business API ─────────────────────────────────────────
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_TOKEN=your_whatsapp_access_token
WHATSAPP_DEFAULT_TO=+212XXXXXXXXX

# ─── File Storage ─────────────────────────────────────────────────
UPLOADS_DIR=./uploads
CV_OUTPUT_DIR=./generated-cvs

# ─── Scraping ─────────────────────────────────────────────────────
SCRAPER_CONCURRENCY=2
SCRAPER_DELAY_MS=2000
SCRAPER_MAX_RETRIES=3
PROXY_URL=                    # optional: http://user:pass@host:port

# ─── LaTeX ────────────────────────────────────────────────────────
LATEX_BIN=/usr/bin/pdflatex
LATEX_TIMEOUT_MS=30000
